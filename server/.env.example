# Local development. Copy to .env and fill in the values.
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173

# TikTok for Developers -> your app -> Login Kit
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Must match exactly the redirect URI registered in the TikTok app.
# For local OAuth testing, expose this URL with a tunnel (cloudflared, ngrok, ...).
TIKTOK_REDIRECT_URI=http://localhost:5173/api/auth/tiktok/callback

# user.info.profile is required for the username (@handle).
TIKTOK_SCOPES=user.info.basic,user.info.profile
TIKTOK_FIELDS=open_id,union_id,avatar_url,display_name,username,profile_deep_link

# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=
